# =============================================================================
# AML IS459 Group 2 — Environment Configuration (.env)
# 
# INSTRUCTIONS:
# 1. Copy this template: cp .env.example .env
# 2. Fill in your credentials below.
# 3. NEVER commit your real .env file or credentials to git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AWS Credentials & Region
# -----------------------------------------------------------------------------
# Where to obtain:
# - Personal AWS: AWS Console -> IAM -> Users -> Security credentials -> Create Access Key
# - AWS Academy / Learner Lab: Click "AWS Details" -> "Show" -> copy all values
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Optional: AWS Session Token (Required if using AWS Academy or AWS SSO)
# AWS_SESSION_TOKEN=your_session_token_if_using_aws_academy

# -----------------------------------------------------------------------------
# 2. AWS S3 Medallion Bucket Configuration
# -----------------------------------------------------------------------------
# The S3 bucket name created in your AWS account (e.g. "my-aml-analytics-bucket").
# Exact prefixes automatically managed by the pipeline:
#   s3://<S3_BUCKET_NAME>/bronze/      (Raw CSVs: HI-Small_Trans.csv, HI-Small_accounts.csv)
#   s3://<S3_BUCKET_NAME>/processed/   (Processed Parquet splits: train, val, test)
#   s3://<S3_BUCKET_NAME>/evaluation/  (metrics.json, confusion_matrix.png, pr_curve.png)
#   s3://<S3_BUCKET_NAME>/model/       (xgboost_aml_model.json, xgboost_model.joblib)
S3_BUCKET_NAME=your-aml-bucket

# -----------------------------------------------------------------------------
# 3. AWS EMR Cluster Configuration (Optional for Cloud Execution)
# -----------------------------------------------------------------------------
# Set to an active EMR Cluster ID (e.g. j-2AXXXXXX) if running Spark ETL on AWS EMR.
EMR_CLUSTER_ID=j-XXXXXXXXXXXX

# -----------------------------------------------------------------------------
# 4. Kaggle API Credentials
# -----------------------------------------------------------------------------
# Where to obtain:
# 1. Sign in to https://www.kaggle.com
# 2. Go to Profile Settings -> Account -> API section
# 3. Click "Create New Token" (downloads kaggle.json)
# 4. Copy the username and key values here:
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

