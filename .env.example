# Copy to .env and fill in. Never commit .env.

# AWS: prefer a named profile over raw keys
AWS_PROFILE=aml-bq2
AWS_REGION=ap-southeast-1
AML_BUCKET=aml-bq2-YOUR_TEAM_NAME
ATHENA_DATABASE=aml_bq2
ATHENA_OUTPUT=s3://aml-bq2-YOUR_TEAM_NAME/athena-results/

# Kaggle (only needed for scripts/download_aml.py)
KAGGLE_USERNAME=YOUR_KAGGLE_USERNAME
KAGGLE_KEY=YOUR_KAGGLE_KEY_HERE

# Claude agent: use ONE of these
# Option A: Amazon Bedrock (uses the AWS profile above)
AGENT_PROVIDER=bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Option B: Anthropic API
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
# ANTHROPIC_MODEL=YOUR_CLAUDE_MODEL_NAME
