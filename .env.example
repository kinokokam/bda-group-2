# =============================================================================
# AML IS459 Group 2 — environment configuration
# 1. Copy this template:  cp .env.example .env
# 2. Fill in your values below. Placeholders only in this file.
# 3. NEVER commit your real .env file or any credentials to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AWS access and region
# -----------------------------------------------------------------------------
# Preferred: a named AWS CLI profile (set up once with: aws configure --profile aml-bq2).
AWS_PROFILE=aml-bq2
# Region for S3 and Athena
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

# Alternative, only if you do NOT use a profile (e.g. AWS Academy / Learner Lab).
# Leave these commented when AWS_PROFILE is set: keys in .env override the profile.
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_if_using_aws_academy

# -----------------------------------------------------------------------------
# 2. S3 and Athena (BQ2 pipeline)
# -----------------------------------------------------------------------------
AML_BUCKET=aml-bq2
ATHENA_DATABASE=aml_bq2
ATHENA_OUTPUT=s3://aml-bq2/athena-results/
# ATHENA_WORKGROUP=primary

# Bucket for the Spark ETL / training pipeline (bronze/, processed/, evaluation/, model/)
S3_BUCKET_NAME=your-aml-bucket

# -----------------------------------------------------------------------------
# 3. AWS EMR (optional, only for running the Spark ETL on EMR; EMR costs money while it runs)
# -----------------------------------------------------------------------------
EMR_CLUSTER_ID=j-XXXXXXXXXXXX

# -----------------------------------------------------------------------------
# 4. Local data paths (defaults shown)
# -----------------------------------------------------------------------------
# AML_DATA_DIR=~/aml_data
# AML_FX_RATES=~/aml_data/aml_out/fx_rates.csv

# -----------------------------------------------------------------------------
# 5. Kaggle API (only for downloading the dataset)
# -----------------------------------------------------------------------------
# kaggle.com -> Settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# -----------------------------------------------------------------------------
# 6. Claude triage agent
# -----------------------------------------------------------------------------
# Option A: Amazon Bedrock (uses the AWS profile above)
AGENT_PROVIDER=bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Where Bedrock calls enter. The global Haiku 4.5 profile failed from ap-southeast-1 on 19 Oct
# but works from us-east-1, so keep this separate from AWS_REGION.
BEDROCK_REGION=us-east-1
# Option B: Anthropic API
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=your_claude_model_name
